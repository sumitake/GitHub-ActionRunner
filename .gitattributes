* text=auto eol=lf
*.go text eol=lf
*.sh text eol=lf
*.png binary
*.gz binary
# Preserve upstream license-document bytes and their recorded SHA-256 values.
release/runner-license-texts/*.txt -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve unified diff context, including its leading space on blank lines.
release/runner-rebuild.patch -text whitespace=-blank-at-eol
