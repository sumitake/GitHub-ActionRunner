<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <RuntimeFrameworkVersion>8.0.32</RuntimeFrameworkVersion><RollForward>Disable</RollForward>
    <StartupObject>ContractHarness</StartupObject><ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers><Deterministic>true</Deterministic>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
