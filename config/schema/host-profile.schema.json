{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-ghar.example.invalid/schema/host-profile.schema.json",
  "title": "Portable GHAR host profile",
  "description": "Portable, class-of-host capability declaration used by the fleet controller to decide adapter and execution posture. Deliberately excludes any deployment-specific fact: no free-form host paths, IP literals, hostnames, or schedules are permitted anywhere in this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter", "capabilities", "executionMode", "conformanceProbes"],
  "properties": {
    "adapter": {
      "enum": ["qts", "systemd"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel", "docker"],
      "properties": {
        "kernel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["portable"],
          "properties": {
            "portable": {
              "type": "boolean"
            },
            "minimumVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
            }
          }
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "rootless"],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "rootless": {
              "type": "boolean"
            },
            "minimumApiVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$"
            }
          }
        }
      }
    },
    "executionMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture"],
      "properties": {
        "posture": {
          "enum": ["non-root", "degraded-root"]
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "anyOf": [
              {
                "pattern": "(^|[^A-Za-z0-9])/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+"
              },
              {
                "pattern": "[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}"
              },
              { "pattern": "[0-9A-Fa-f]{0,4}(:[0-9A-Fa-f]{0,4}){3,}" }
            ]
          }
        }
      }
    },
    "conformanceProbes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/portableToken" }
    }
  },
  "$defs": {
    "portableToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "not": {
        "anyOf": [
          { "pattern": "(^|[^A-Za-z0-9])/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+" },
          { "pattern": "[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}" }
        ]
      },
      "description": "A stable, portable capability/probe name. Never an absolute host path, IP literal, hostname, or schedule expression."
    }
  }
}
