{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-ghar.example.invalid/schema/public-log-event.schema.json",
  "title": "Portable GHAR public log event",
  "description": "Allowlist-only public log event. Carries structured, enumerated fields safe for public/external consumption; no free-form message or raw payload fields are permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["identifier", "component", "event", "severity", "receiptTime"],
  "properties": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
    },
    "severity": {
      "enum": ["debug", "info", "notice", "warning", "error", "critical"]
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "receiptTime": {
      "type": "string",
      "format": "date-time"
    },
    "buildId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
