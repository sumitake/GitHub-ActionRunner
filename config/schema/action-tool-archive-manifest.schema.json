{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-ghar.invalid/schema/action-tool-archive-manifest-v1.json",
  "title": "Portable-GHAR verified action and tool archive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seeds"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "seeds": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/seed"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._+/-]+$",
      "not": {
        "pattern": "(^/|(^|/)\\.\\.?(/|$)|//|\\\\)"
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "target", "sha256", "size", "mode"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "target": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "enum": [292, 365]
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "path", "size", "sha256"],
      "properties": {
        "spdx": {
          "enum": ["Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "MIT"]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "revision", "license", "files"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "kind": {
          "enum": ["action", "tool"]
        },
        "source": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://github\\.com/actions/[A-Za-z0-9._+-]+/"
        },
        "revision": {
          "type": "string"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action"
              }
            }
          },
          "then": {
            "properties": {
              "revision": {
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool"
              }
            }
          },
          "then": {
            "properties": {
              "revision": {
                "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
              }
            }
          }
        }
      ]
    }
  }
}
