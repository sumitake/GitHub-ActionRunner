{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-ghar.example.invalid/schema/notification-event.schema.json",
  "title": "Portable GHAR notification event",
  "description": "Allowlist-only notification event delivered to email/webhook channels. All fields are structured or enumerated; no free-text field is permitted, including operatorAction which is a closed enumeration rather than free-form guidance text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "transitionId",
    "displayName",
    "repositoryAliases",
    "confirmedRoute",
    "reasonCode",
    "receiptTime",
    "operatorAction"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "transitionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,127}$",
      "description": "A synthetic, human-readable display label. Not derived from real deployment identity."
    },
    "repositoryAliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "confirmedRoute": {
      "enum": ["hosted", "self-hosted", "legacy"]
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "receiptTime": {
      "type": "string",
      "format": "date-time"
    },
    "operatorAction": {
      "enum": ["none", "acknowledge", "escalate", "retry", "rollback", "suppress"]
    }
  }
}
