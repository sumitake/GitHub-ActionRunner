{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-ghar.example.invalid/schema/fleet.schema.json",
  "title": "Portable GHAR fleet configuration",
  "description": "Fleet-level capacity, repository, network-policy, health, canary, and notification configuration for the portable GHAR control plane. Contains no deployment-specific facts: secrets are referenced by name only, and repository identity fields are placeholders bound out-of-band at deploy time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capacity",
    "repositories",
    "hostProfileRef",
    "networkPolicy",
    "evaluationIntervalSeconds",
    "unhealthyObservationsBeforeFailover",
    "canaryPolicy",
    "notifications",
    "heartbeatKeyRef"
  ],
  "properties": {
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "profiles"],
      "properties": {
        "units": {
          "type": "integer",
          "minimum": 0,
          "description": "Total capacity units available to the fleet."
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "weight"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository" }
    },
    "hostProfileRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "description": "Reference id to a host-profile.schema.json instance; not the profile content itself."
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addressFamily", "blockedEgressClasses"],
      "properties": {
        "addressFamily": {
          "const": "public-ipv4-only"
        },
        "blockedEgressClasses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "loopback",
            "privateUniqueLocal",
            "linkLocalMetadata",
            "sharedCgnat",
            "reservedDocumentationBenchmarking",
            "multicastBroadcast",
            "dockerHostBridgeManagement",
            "outsidePublicUnicastByExclusion"
          ],
          "properties": {
            "loopback": { "$ref": "#/$defs/blockedEgressClass" },
            "privateUniqueLocal": { "$ref": "#/$defs/blockedEgressClass" },
            "linkLocalMetadata": { "$ref": "#/$defs/blockedEgressClass" },
            "sharedCgnat": { "$ref": "#/$defs/blockedEgressClass" },
            "reservedDocumentationBenchmarking": {
              "$ref": "#/$defs/blockedEgressClass"
            },
            "multicastBroadcast": { "$ref": "#/$defs/blockedEgressClass" },
            "dockerHostBridgeManagement": {
              "$ref": "#/$defs/blockedEgressClass"
            },
            "outsidePublicUnicastByExclusion": {
              "$ref": "#/$defs/blockedEgressClass"
            }
          }
        }
      }
    },
    "evaluationIntervalSeconds": {
      "const": 60
    },
    "staleThresholdSeconds": {
      "type": "integer",
      "minimum": 1,
      "default": 360
    },
    "unhealthyObservationsBeforeFailover": {
      "const": 2
    },
    "canaryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostingPosture",
        "mode",
        "expectedRevision",
        "repositoryAlias",
        "workflow"
      ],
      "properties": {
        "hostingPosture": {
          "const": "safe-hosted"
        },
        "mode": {
          "enum": ["automatic", "manual"]
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "repositoryAlias": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "workflow": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.ya?ml$"
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "webhook"],
      "properties": {
        "email": {
          "const": true
        },
        "webhook": {
          "type": "boolean"
        }
      }
    },
    "heartbeatKeyRef": { "$ref": "#/$defs/secretReferenceName" }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "owner",
        "repository",
        "weight",
        "agingThresholdSeconds",
        "maxConcurrency",
        "archiveEligibility"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "owner": {
          "const": "owner",
          "description": "Placeholder-only field: real owner identity is bound out-of-band at deploy time, never committed here."
        },
        "repository": {
          "const": "repository",
          "description": "Placeholder-only field: real repository identity is bound out-of-band at deploy time, never committed here."
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "agingThresholdSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 0
        },
        "archiveEligibility": {
          "enum": ["active", "archived-disabled", "pending-reactivation"]
        }
      }
    },
    "blockedEgressClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "cidrs"],
      "properties": {
        "posture": {
          "const": "deny"
        },
        "cidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$"
          },
          "uniqueItems": true
        }
      }
    },
    "secretReferenceName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]*$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z0-9+/=]{20,}$"
          },
          {
            "pattern": "^(ghp_|gho_|ghs_|ghr_|ghu_|github_pat_|sk-|sk_live_|sk_test_|AKIA|ASIA|xox[baprs]-|-----BEGIN)"
          }
        ]
      },
      "description": "A name/reference to a secret (e.g. an env var name or secret-manager path), never the secret value itself."
    }
  }
}
