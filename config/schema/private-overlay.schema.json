{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-ghar.example.invalid/schema/private-overlay.schema.json",
  "title": "Portable GHAR private overlay (synthetic tests only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targetId",
    "accountRef",
    "hostRef",
    "fleetIds",
    "fleetIdsRevision",
    "fleetIdsDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "targetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "accountRef": { "$ref": "#/$defs/secretReference" },
    "hostRef": { "$ref": "#/$defs/secretReference" },
    "fleetIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    },
    "fleetIdsRevision": { "type": "string", "minLength": 1, "maxLength": 64 },
    "fleetIdsDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "secretReference": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]*$",
      "not": {
        "anyOf": [
          { "pattern": "^[A-Za-z0-9+/=]{20,}$" },
          {
            "pattern": "^(ghp_|gho_|ghs_|ghr_|ghu_|github_pat_|sk-|sk_live_|sk_test_|AKIA|ASIA|xox[baprs]-|-----BEGIN)"
          }
        ]
      }
    }
  }
}
